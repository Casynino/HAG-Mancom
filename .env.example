# ---------------------------------------------------------------------------
# HA GROUP AI Operations Platform — environment configuration
#
# Copy to .env.local for development. Never commit real values.
# For Vercel, set the same keys under Project → Settings → Environment Variables.
#
# Verify a filled-in environment with:  npm run preflight
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The runtime connection. This MUST be the restricted role: not a superuser,
# not BYPASSRLS, and not the owner of the tables. Row Level Security is the
# authorisation boundary in this platform, and all three of those attributes
# silently switch it off.
#
# Neon:  postgresql://hagroup_app:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://hagroup_app:CHANGE_ME@localhost:5432/hagroup"

# Owns the schema. Used by migrations and the preflight check — never by the
# running application. Not required as a Vercel environment variable.
DATABASE_ADMIN_URL="postgresql://hagroup_owner:CHANGE_ME@localhost:5432/hagroup"

# Only needed to create the two roles above, once.
#   Self-hosted Postgres: a superuser.       npm run db:bootstrap
#   Neon: your neondb_owner connection URL.  npm run db:bootstrap:neon
DATABASE_SUPERUSER_URL=""

# "neon" uses the serverless WebSocket driver and is the right choice on Vercel.
# "node-postgres" is a normal TCP pool, for local and self-hosted deployments.
DB_DRIVER="node-postgres"

# Connections per instance. Leave unset unless you have measured a reason;
# serverless functions multiply this by the number of concurrent instances.
# DB_POOL_MAX="10"

# --- Storage ---------------------------------------------------------------
# Where uploaded files live: site photographs, delivery signatures, purchase
# order scans, brand assets, rendered documents.
#
# "local" writes to the filesystem and is for development only. On Vercel the
# filesystem is ephemeral, so uploads would disappear between requests —
# preflight fails the deploy if it sees that combination.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Required when STORAGE_DRIVER="vercel-blob". Created for you when you add a
# Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=""

# --- First Administrator ---------------------------------------------------
# Used once by `npm run db:seed` to create the first account, which is created
# with must_change_password = true. Remove these three values from the
# environment after that account has signed in successfully.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# ---------------------------------------------------------------------------
# Optional integrations.
#
# The platform runs without every one of these. Each feature reports honestly
# that it is unavailable rather than failing silently or pretending to have
# succeeded — an unconfigured email provider queues the message and says so.
# ---------------------------------------------------------------------------

# AI assistant. Drafts wording only: scope text and letter prose. It is never
# given prices, never returns figures, never allocates a document number and
# never approves anything.
ANTHROPIC_API_KEY=""

# Email. Without these, messages are recorded as failed and can be retried from
# the document page once credentials are set.
RESEND_API_KEY=""
EMAIL_FROM="business@hpcagroup.africa"

# --- Document rendering ----------------------------------------------------
# Century Gothic is a licensed Monotype font and is NOT bundled with this
# repository. Drop the TTF files in this directory and documents render in the
# company typeface; otherwise the renderer substitutes Helvetica and records on
# the document that it did so.
DOCUMENT_FONT_DIR="./assets/fonts"

# --- TRA / EFD -------------------------------------------------------------
# There is no TRA integration and no environment variable for one. The platform
# does not issue fiscal receipts. An EFD receipt number is recorded by a person
# from a certified fiscal device, and the platform stores it as evidence.
