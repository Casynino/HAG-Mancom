# ---------------------------------------------------------------------------
# HA GROUP AI Operations Platform — environment configuration
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Runtime database connection. The application connects as a RESTRICTED role so
# that Row Level Security is enforced. It must NOT be a superuser and must NOT
# have the BYPASSRLS attribute — see scripts/bootstrap.ts.
DATABASE_URL="postgresql://hagroup_app:CHANGE_ME@localhost:5432/hagroup"

# Migration/DDL connection. Owns the schema. Used only by scripts, never by the app.
DATABASE_ADMIN_URL="postgresql://hagroup_owner:CHANGE_ME@localhost:5432/hagroup"

# Driver selection: "node-postgres" for local/self-hosted, "neon" for Neon serverless.
DB_DRIVER="node-postgres"

# Secret used to sign and hash session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Storage driver: "local" for development, "vercel-blob" for deployed environments.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Required when STORAGE_DRIVER="vercel-blob"
BLOB_READ_WRITE_TOKEN=""

# Bootstrap administrator. Used once by `npm run db:seed` to create the first
# Administrator account. The account is created with must_change_password=true.
# Remove these values from the environment after the first successful sign-in.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
